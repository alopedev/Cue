// Template for Config/Secrets.xcconfig (ignored by git, never committed).
//
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//
// Then replace the placeholder values with your own keys.

// TMDB API Read Access Token (block 2). https://www.themoviedb.org/settings/api
TMDB_API_TOKEN = replace-me

// Trakt client id (batch B). https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID = replace-me
